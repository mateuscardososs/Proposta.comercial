# App runtime
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false

# Web authentication. Create the first active Argon2id account with:
# python -m scripts.bootstrap_first_admin
# The 8013 launcher reads its session secret from a 0600 local file outside Git.
AUTH_ENABLED=true
# For other deployments, provide a random secret of at least 32 characters via the environment.
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_SECONDS=28800
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

# Storage paths (inside container)
OUTPUT_DIR=/app/output
# OCR local de PDFs escaneados no Windows (opcional; configure o executável e tessdata por instalação).
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# TESSERACT_DATA_DIR="C:/Program Files/Tesseract-OCR/tessdata"
TEMPLATE_DOC_PATH=/app/doc_templates/proposta_template.docx
TECHNICAL_REPORT_TEMPLATE_PATH=/app/doc_templates/relatorio_tecnico_template.docx
# Optional local converter image used only if no host LibreOffice command is available.
TECHNICAL_REPORT_PDF_CONVERTER_IMAGE=

# LibreOffice command (inside container)
LIBREOFFICE_CMD=/usr/bin/soffice

# Postgres service settings
POSTGRES_DB=propostas_db
POSTGRES_USER=propostas
POSTGRES_PASSWORD=propostas
POSTGRES_PORT=5432

# SQLAlchemy DSN
DATABASE_URL=postgresql+psycopg://propostas:propostas@db:5432/propostas_db

# DB startup wait strategy
DB_WAIT_TIMEOUT=90
DB_WAIT_INTERVAL=2

# Assistente local (Ollama nativo no host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_READ_TIMEOUT=60
OLLAMA_MAX_OUTPUT_TOKENS=180
# Gemini é o padrão. Use uma chave NOVA, guardada somente em arquivo local ignorado pelo Git.
# Nunca reutilize a chave comprometida anteriormente na conversa.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Modelo de imagem independente do modelo de conversa; pode ser sobrescrito localmente.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_CONNECT_TIMEOUT=3
GEMINI_READ_TIMEOUT=60
# Saída de campanhas é independente do IMAP Yahoo. Sem estes campos, o envio fica desativado.
PROMOTION_SMTP_HOST=
PROMOTION_SMTP_PORT=587
PROMOTION_SMTP_USERNAME=
PROMOTION_SMTP_PASSWORD=
PROMOTION_SMTP_FROM_EMAIL=
PROMOTION_SMTP_FROM_NAME=AD Balanças
PROMOTION_SMTP_STARTTLS=true
PROMOTION_SMTP_USE_SSL=false
PROMOTION_SMTP_TIMEOUT_SECONDS=15
PROMOTION_MAX_REFERENCE_IMAGE_BYTES=8388608
ASSISTANT_TIMEZONE=America/Recife
ASSISTANT_CONTEXT_MESSAGES=12
ASSISTANT_REQUEST_LEASE_SECONDS=120

# Voz local opcional (modelos nao entram no Git)
VOICE_ENABLED=true
VOICE_MODEL_DIR=/app/.models/assistant_voice
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_LANGUAGE=pt
VOICE_WHISPER_INITIAL_PROMPT="Crie uma tarefa. Pode criar. Sim, confirmo. Nao, cancela."
VOICE_PIPER_MODEL_PATH=/app/.models/assistant_voice/pt_BR-faber-medium.onnx
# Omitidas por padrao para usar a voz natural; 0 torna validacoes sinteticas deterministicas.
# VOICE_PIPER_NOISE_SCALE=0
# VOICE_PIPER_NOISE_W_SCALE=0
VOICE_MAX_UPLOAD_BYTES=8388608
VOICE_MIN_DURATION_SECONDS=0.25
VOICE_MAX_DURATION_SECONDS=30
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=60
VOICE_SYNTHESIS_TIMEOUT_SECONDS=30
VOICE_SILENCE_MS=1200
VOICE_IDLE_TIMEOUT_SECONDS=120
